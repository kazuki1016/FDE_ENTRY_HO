        <mxCell id="title-text" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" value="常時稼働構成 案B-VPCE: ECS Fargate + VPC エンドポイント (インターネット出口ゼロ)" vertex="1" parent="title-group">
          <mxGeometry height="42" width="1900" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" value="案B をベースに NAT Gateway / インターネットゲートウェイをプライベート経路から排除。Bedrock ・ Secrets Manager ・ ECR ・ CloudWatch ・ S3 への通信はすべて VPC エンドポイント (PrivateLink) で AWS バックボーン内に閉じる。Bedrock へ送るテキストは公開インターネットを経由しない。" vertex="1" parent="title-group">
          <mxGeometry height="25" width="2100" x="5" y="44" as="geometry" />
        </mxCell>
        <mxCell id="title-separator" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" value="" vertex="1" parent="title-group">
